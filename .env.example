# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Non-secret knobs can instead live in config.yaml (see config.example.yaml);
# any value set here overrides the yaml.

# --- Slack (create an app at https://api.slack.com/apps) ---
# Bot User OAuth Token (starts with xoxb-). Scopes: app_mentions:read, chat:write,
# commands, channels:history.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token (starts with xapp-) for Socket Mode. Scope: connections:write.
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret from the app's Basic Information page. OPTIONAL: only needed for
# an HTTP request receiver — Socket Mode does not use it, so you can leave it unset.
SLACK_SIGNING_SECRET=your-signing-secret
# Channel id (not name). Default is the PRODUCTION channel
# #dl-time-series-tabular (C03J1AVLGFM). For TESTING, use the test channel
# #thoughts-on-lunch (C0C4DT9J75Z).
SLACK_CHANNEL_ID=C03J1AVLGFM
# Optional human-readable channel name for display in messages.
# Quoted because sky.yaml sources this file as a shell script (see run: block).
SLACK_CHANNEL_NAME="#dl-time-series-tabular"
# Comma- or space-separated Slack member IDs allowed to remove poll choices or
# candidate restaurants. Everyone can add; only these managers can remove.
SLACK_MANAGER_USER_IDS=U0AA0UMN333
# Keep false for fully manual poll/reminder operation. Set true to enable the
# cron schedule in config.yaml.
SCHEDULER_ENABLED=false

# --- Google Places / Geocoding (https://console.cloud.google.com/) ---
# Enable "Places API" and "Geocoding API" for this key.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- LLM provider (for semantic routing, cuisine tagging, and conversational QA) ---
# Choose the provider: "anthropic" (Claude) or "openai" (GPT). Only the SELECTED
# provider's API key below is required; the LLM is optional overall.
LLM_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com/) — needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key
# Small/fast Anthropic model used for cuisine tagging + suggestion parsing.
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (https://platform.openai.com/api-keys) — needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-your-openai-key
# Small/cheap OpenAI model used for cuisine tagging + suggestion parsing.
OPENAI_MODEL=gpt-4o-mini

# --- Non-secret config knobs (optional; can also live in config.yaml) ---
# Office location and search radius (metres).
# Quoted because sky.yaml sources this file as a shell script; the spaces/comma
# would otherwise break sourcing (each word treated as a separate command).
OFFICE_ADDRESS="661 University Ave, Toronto"
OFFICE_LAT=43.6579
OFFICE_LNG=-79.3883
SEARCH_RADIUS_M=5000
# Poll size (keep 4..6) and the coarse price ceiling (Google price_level 0..4).
POLL_SIZE=5
MAX_POLL_OPTIONS=10
MAX_PRICE_LEVEL=2
# UCB exploration weight for selection.
EXPLORATION_C=1.0
# SQLite database file path (gitignored).
DB_PATH=lunch_bot.db
# Candidate source for the seed script (a group can point at its own list).
RESTAURANTS_CSV=data/restaurants_seed.csv
# Scheduler timezone. The weekly schedule (poll_create / poll_close /
# order_reminder / order_deadline days + times) lives in config.yaml — see
# config.example.yaml.
TIMEZONE=America/Toronto
